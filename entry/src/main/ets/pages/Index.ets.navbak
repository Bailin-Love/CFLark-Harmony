          this.runSpeedTop();
        })
      Text('导出 TXT')
        .fontSize(12)
        .fontColor(this.txt2())
        .textAlign(TextAlign.Center)
        .width(88)
        .height(40)
        .backgroundColor(this.soft())
        .borderRadius(10)
        .margin({ left: 8 })
        .onClick(() => {
          this.doExport(ExportFormat.PLAIN_COLO_DELAY);
        })
      Text('导出 CSV')
        .fontSize(12)
        .fontColor(this.txt2())
        .textAlign(TextAlign.Center)
        .width(88)
        .height(40)
        .backgroundColor(this.soft())
        .borderRadius(10)
        .margin({ left: 8 })
        .onClick(() => {
          this.doExport(ExportFormat.CSV);
        })
    }
    .width('100%')
    .margin({ bottom: 10 })
  }

  // ---------- 第一轮：筛选结果（按地区分组，可展开看延迟） ----------
  @Builder PingPage() {
    Scroll(this.pingScroller) {
      Column() {
            Row().width('100%').height(px2vp(this.statusBarPx) + 92).hitTestBehavior(HitTestMode.None)
        Row() {
          Text('第一轮通过 ' + this.pingList.length.toString() + ' 个')
            .fontSize(13)
            .fontWeight(FontWeight.Medium)
            .fontColor(this.txt())
          Text(' · ' + this.groups.length.toString() + ' 个地区')
            .fontSize(12)
            .fontColor(this.txt3())
          Blank()
          Text('开始测速')
            .fontSize(12)
            .fontColor('#FFFFFF')
            .textAlign(TextAlign.Center)
            .width(88)
            .height(34)
            .backgroundColor(this.accent())
            .borderRadius(9)
            .onClick(() => {
              this.startSpeedTest();
            })
        }
        .width('100%')
        .margin({ bottom: 10 })

        Row() {
          Text('地区码')
            .fontSize(12)
            .fontColor(this.txt2())
            .width(52)
          TextInput({ text: this.regionCode, placeholder: '可留空；如 HKG / LAX' })
            .layoutWeight(1)
            .height(36)
            .fontSize(12)
            .fontColor(this.txt())
            .backgroundColor(this.inputBg())
            .borderRadius(9)
            .onChange((v: string) => {
              this.regionCode = v.toUpperCase();
            })
        }
        .width('100%')
        .margin({ bottom: 10 })

        Text('先看下面各地区的最快延迟，挑延迟低的地区填码，再点右上「开始测速」；留空则测全部地区。')
          .fontSize(11)
          .fontColor(this.txt3())
          .margin({ bottom: 12 })

        if (this.pingList.length === 0) {
          Column() {
            Text('还没有筛选结果')
              .fontSize(15)
              .fontColor(this.txt2())
            Text('回到「扫描」页开始优选')
              .fontSize(12)
              .fontColor(this.txt3())
              .margin({ top: 6 })
          }
          .width('100%')
          .padding({ top: 60, bottom: 30 })
        }

        GridRow({
          columns: { sm: 12, md: 12, lg: 12 },
          gutter: { x: 14, y: 0 },
          breakpoints: { value: ['600vp', '900vp'], reference: BreakpointsReference.WindowSize }
        }) {
          ForEach(this.groups, (g: RegionGroup) => {
            GridCol({ span: { sm: 12, md: 6, lg: 4 } }) {
              this.GroupRow(g)
            }
          }, (g: RegionGroup) => g.colo + '#' + g.count.toString() + '#' +
            (this.expandedColos.indexOf(g.colo) >= 0 ? '1' : '0'))
        }
        .width('100%')

        Column().height(112)
      }
      .width('100%')
      .padding({ left: 16, right: 16, top: 12, bottom: 112 })
      .constraintSize({ maxWidth: 1600 })
    }
    .width('100%')
    .height('100%')
    .scrollBar(BarState.Off)
    .edgeEffect(EdgeEffect.Spring)
    .onScroll(() => {
      this.anyScrollY = this.pingScroller.currentOffset().yOffset;
    })
  }

  @Builder GroupRow(g: RegionGroup) {
    Column() {
      Row() {
        Column() {
          Text(g.colo === 'UNK' ? 'UNK 未知地区' : (Geo.flag(g.colo) + ' ' + Geo.placeZh(g.colo)))
            .fontSize(14)
            .fontWeight(FontWeight.Medium)
            .fontColor(this.txt())
          Text(g.count.toString() + ' 个 · 最快 ' + (g.minLatency > 0 ? Math.round(g.minLatency).toString() : '—') +
            'ms · 平均 ' + (g.avgLatency > 0 ? Math.round(g.avgLatency).toString() : '—') + 'ms')
            .fontSize(11)
            .fontColor(this.txt3())
            .margin({ top: 3 })
        }
        .alignItems(HorizontalAlign.Start)
        .layoutWeight(1)
        Text(this.expandedColos.indexOf(g.colo) >= 0 ? '收起' : '展开')
          .fontSize(12)
          .fontColor(this.accent())
      }
      .width('100%')
      .onClick(() => {
        this.toggleGroup(g.colo);
      })

      if (this.expandedColos.indexOf(g.colo) >= 0) {
        Column() {
          ForEach(g.items, (c: Candidate) => {
            Row() {
              Text(Exporter.endpoint(c, true))
                .fontSize(12)
                .fontColor(this.txt2())
                .layoutWeight(1)
              Text(this.delayText(c))
                .fontSize(12)
                .fontColor(OK_C)
            }
            .width('100%')
            .padding({ top: 8, bottom: 8 })
            .onClick(() => {
              this.copyIp(c.ip);
            })
          }, (c: Candidate) => 'p#' + c.ip + ':' + c.port.toString())
        }
        .width('100%')
        .margin({ top: 6 })
        .padding({ left: 8 })
        .border({ width: { left: 2 }, color: this.lineC() })
      }
    }
    .width('100%')
    .alignItems(HorizontalAlign.Start)
    .padding(14)
    .linearGradient({ angle: 145, colors: this.dark ? [['#1FFFFFFF', 0.0], ['#0DFFFFFF', 0.5], ['#05FFFFFF', 1.0]] : [['#3DFFFFFF', 0.0], ['#26FFFFFF', 0.5], ['#12FFFFFF', 1.0]] })
    .borderRadius(20)
    .border({ width: 1, color: this.dark ? '#33FFFFFF' : '#66FFFFFF' })
    .shadow({ radius: 10, color: '#22000000' })
    .margin({ bottom: 10 })
  }

  // ---------- 第二轮：测速结果（只显示参与测速的 N 个） ----------
  @Builder SpeedPage() {
