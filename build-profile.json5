{
  app: {
    // 说明：原工程的 signingConfigs（本机证书路径 + 加密口令）已移除，避免泄露本机签名材料。
    // 在 DevEco Studio 中打开本工程后，Project Structure → Signing Configs 勾选
    // “Automatically generate signature”（或粘贴你自己的签名配置）即可构建、装机。
    products: [
      {
        name: 'default',
        targetSdkVersion: '26.0.0',
        compatibleSdkVersion: '26.0.0',
        runtimeOS: 'HarmonyOS',
        buildOption: {
          strictMode: {
            caseSensitiveCheck: true,
            useNormalizedOHMUrl: true,
          },
        },
      },
    ],
    buildModeSet: [
      {
        name: 'debug',
      },
      {
        name: 'release',
      },
    ],
  },
  modules: [
    {
      name: 'entry',
      srcPath: './entry',
      targets: [
        {
          name: 'default',
          applyToProducts: [
            'default',
          ],
        },
      ],
    },
  ],
}
